# Browser-safe values only. Find both in Supabase Dashboard > Project Settings > API.
# NEVER put the service role key or any secret key in this app.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Public web address of the deployed app. Password reset emails link back here (required for the desktop app).
VITE_PUBLIC_APP_URL=https://your-app.netlify.app
