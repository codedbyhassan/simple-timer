{
  "name": "ascend-hms",
  "productName": "Ascend HMS",
  "version": "0.1.0",
  "private": true,
  "description": "Ascend HMS by Ascend Technologies. Single-hospital management system.",
  "author": "Ascend Technologies",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src electron",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:build": "node scripts/build-all-migrations.mjs",
    "db:test": "bash supabase/tests/run.sh",
    "build:electron": "vite build --mode electron",
    "electron:dev": "concurrently -k \"vite --mode electron --port 5173\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build:electron && electron .",
    "electron:pack": "npm run build:electron && electron-builder"
  },
  "build": {
    "appId": "tech.ascend.hms",
    "productName": "Ascend HMS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
